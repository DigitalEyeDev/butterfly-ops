# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never
# import it into a Client Component. Used only in server actions/route
# handlers to create staff/owner accounts via the Supabase Admin API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
